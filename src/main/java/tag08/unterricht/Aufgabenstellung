package solid.medien;

import java.util.ArrayList;
import java.util.List;

public class Bibliothek
{
    private String name;
    private List<Medium> medien;

    public Bibliothek(String name)
    {
        this.name = name;
        this.medien = new ArrayList<>();
    }

    public String getName()
    {
        return name;
    }

    public void mediumHinzufuegen(Medium medium)
    {
        medien.add(medium);
    }

    public List<Medium> getMedien()
    {
        return medien;
    }

    public void alleMedienAusgeben()
    {
        System.out.println("Medien in der Bibliothek " + name + ":");

        for (Medium medium : medien)
        {
            System.out.println(medium.beschreibe());
            System.out.println(medium.gibMedienInfo());

            switch (medium.getStatus())
            {
                case VERFUEGBAR:
                    System.out.println("Statusprüfung: Das Medium ist aktuell verfügbar.");
                    break;
                case AUSGELIEHEN:
                    System.out.println("Statusprüfung: Das Medium ist momentan ausgeliehen.");
                    break;
                case RESERVIERT:
                    System.out.println("Statusprüfung: Das Medium ist reserviert.");
                    break;
                case BESCHAEDIGT:
                    System.out.println("Statusprüfung: Das Medium ist beschädigt.");
                    break;
            }

            System.out.println();
        }
    }
}

